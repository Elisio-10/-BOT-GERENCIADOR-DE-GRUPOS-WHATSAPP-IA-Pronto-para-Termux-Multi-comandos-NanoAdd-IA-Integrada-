
const sqlite3 = require('sqlite3').verbose();
const db = new sqlite3.Database('grupos_ia.db');

db.serialize(() => {
    // Configurações por grupo
    db.run(`CREATE TABLE IF NOT EXISTS configs (
        chatId TEXT PRIMARY KEY,
        antispam INTEGER DEFAULT 1,
        bemvindo INTEGER DEFAULT 1,
        antilink INTEGER DEFAULT 0,
        nivel TEXT DEFAULT 'basico'
    )`);
    
    // Bans permanentes
    db.run(`CREATE TABLE IF NOT EXISTS bans (
        numero TEXT,
        chatId TEXT,
        motivo TEXT,
        data TEXT DEFAULT CURRENT_TIMESTAMP,
        PRIMARY KEY(numero, chatId)
    )`);
    
    // Comandos custom NANOADD
    db.run(`CREATE TABLE IF NOT EXISTS nano_cmds (
        chatId TEXT,
        comando TEXT,
        resposta TEXT,
        PRIMARY KEY(chatId, comando)
    )`);
    
    // Logs mensagens deletadas
    db.run(`CREATE TABLE IF NOT EXISTS logs (
        chatId TEXT,
        author TEXT,
        acao TEXT,
        data TEXT DEFAULT CURRENT_TIMESTAMP
    )`);
});

module.exports = db;
