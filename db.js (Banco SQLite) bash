cat > database.js << 'EOF'
const sqlite3 = require('sqlite3').verbose();
const db = new sqlite3.Database('grupos.db');

db.run(`CREATE TABLE IF NOT EXISTS bans (
  id INTEGER PRIMARY KEY,
  groupId TEXT,
  userId TEXT,
  reason TEXT,
  bannedBy TEXT,
  date TEXT
)`);

db.run(`CREATE TABLE IF NOT EXISTS custom_cmds (
  id INTEGER PRIMARY KEY,
  groupId TEXT,
  trigger TEXT,
  response TEXT
)`);

module.exports = db;
EOF
