
const { Client, LocalAuth } = require('whatsapp-web.js');
const qrcode = require('qrcode-terminal');
const chalk = require('chalk');
const db = require('./db');
const config = require('./config');
const { adminCmds, groupProtections, iaChat } = require('./handlers');

const client = new Client({
    authStrategy: new LocalAuth({ clientId: 'grupos-ia-v3' }),
    puppeteer: { 
        headless: true,
        args: ['--no-sandbox', '--disable-setuid-sandbox']
    }
});

client.on('qr', (qr) => {
    console.log(chalk.bgGreen('📱 ESCANEIE QR CODE:'));
    qrcode.generate(qr, { small: true });
});

client.on('ready', () => {
    console.log(chalk.greenBright('✅ [IA-GRUPO] Bot Conectado!'));
    console.log(chalk.yellow(`👑 Admin: ${config.ADMIN_NUM}`));
    console.log(chalk.cyan('📋 Comandos: !config !ban !addcmd !clear'));
});

client.on('message', async (msg) => {
    const chat = await msg.getChat();
    const texto = msg.body.trim();
    const authorId = msg.author?.id._serialized || msg.from;
    
    // ========== ADMIN COMMANDS ==========
    if (authorId === config.ADMIN_NUM || msg.from === config.ADMIN_NUM) {
        await adminCmds(msg, client, db);
        return;
    }
    
    // ========== GROUP HANDLER ==========
    if (chat.isGroup) {
        await groupProtections(msg, client, db, chat.id._serialized);
        
        // ========== IA CONVERSACIONAL ==========
        if (config.IA_ATIVA) {
            const iaResp = await iaChat(texto.toLowerCase());
            if (iaResp) msg.reply(iaResp);
        }
    }
});

client.initialize();

process.on('unhandledRejection', (err) => {
    console.log(chalk.red('❌ Erro:', err.message));
});
